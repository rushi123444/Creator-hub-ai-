# Elastic Beanstalk (Python 3.11 platform). Deploy the contents of backend/ as the app bundle (Procfile at root).
option_settings:
  aws:elasticbeanstalk:application:environment:
    APP_ENV: production
    AUTO_SEED: "false"
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /health
# Set JWT_SECRET, DATABASE_URL, CORS_ORIGINS, FRONTEND_URL, OPENAI_API_KEY with:
#   eb setenv JWT_SECRET=... (or console > Configuration > Updates > Environment properties)
