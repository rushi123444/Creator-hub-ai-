# CreatorHub AI - root env file used by docker-compose.yml.
# Copy to .env and fill in. NEVER commit .env. Backend-only variables are documented in backend/.env.example.
APP_ENV=development
JWT_SECRET=
# Optional integrations (leave blank for sample mode)
OPENAI_API_KEY=
YOUTUBE_API_KEY=
# Docker compose
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Optional local Postgres (docker compose --profile postgres)
POSTGRES_PASSWORD=
# Frontend build-time API URL (public, not secret)
VITE_API_URL=/api/v1
