# CreatorHub AI backend. Copy to backend/.env. NEVER commit real values.
# development | demo | production
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Defaults to sqlite:///./creatorhub.db outside production. REQUIRED in production.
# Supabase: use the pooled/direct Postgres URI with the psycopg driver prefix:
# postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=

# Optional Supabase (backend only, never expose to the frontend)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: blank => sample mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
YOUTUBE_API_KEY=

# REQUIRED in production: random string of at least 32 characters
# generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
JWT_REMEMBER_EXPIRE_MINUTES=43200

# Production: exact origins, comma separated, no '*'
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# true seeds demo data when DB is empty (default: true in dev/demo, false in production)
AUTO_SEED=true
AI_RATE_LIMIT_PER_MINUTE=20
AI_DAILY_LIMIT_PER_USER=200

# Only for: python -m app.scripts.create_admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
